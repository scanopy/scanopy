[
  {
    "id": "SnmpV1",
    "name": "SNMP v1",
    "description": "Discover a host's interfaces, system details, and CDP/LLDP neighbors. Uses SNMPv1.",
    "category": "Network Monitoring",
    "icon": "activity",
    "color": "Yellow",
    "metadata": {
      "associated_service": "SNMP",
      "fields": [
        {
          "field_type": "secretpathorinline",
          "help_text": "Custom SNMP community string. The default 'public' community is always tried automatically during scans.",
          "id": "community",
          "inline_format": "plain",
          "label": "Community String",
          "optional": false,
          "placeholder": "custom-community-string",
          "secret": true
        }
      ],
      "has_logo": false,
      "logo_ext": "",
      "logo_needs_white_background": false,
      "requires_config": true,
      "single_endpoint_per_host": false,
      "targets": [
        "DaemonHost",
        "Hosts",
        "Network"
      ]
    }
  },
