  {
    "id": "SnmpV3",
    "name": "SNMP v3",
    "description": "Discover a host's interfaces, system details, and CDP/LLDP neighbors. Uses SNMPv3.",
    "category": "Network Monitoring",
    "icon": "activity",
    "color": "Yellow",
    "metadata": {
      "associated_service": "SNMP",
      "fields": [
        {
          "field_type": "string",
          "group": "Authentication",
          "help_text": "SNMPv3 USM user name (security name).",
          "id": "security_name",
          "label": "Security Name",
          "optional": false,
          "placeholder": "snmp-user",
          "secret": false
        },
        {
          "default_value": "Sha256",
          "field_type": "select",
          "group": "Authentication",
          "help_text": "Authentication hash algorithm.",
          "id": "auth_protocol",
          "label": "Auth Protocol",
          "optional": false,
          "options": [
            {
              "label": "SHA-1",
              "value": "Sha1"
            },
            {
              "label": "SHA-256",
              "value": "Sha256"
            }
          ],
          "secret": false
        },
        {
          "field_type": "secretpathorinline",
          "group": "Authentication",
          "help_text": "Authentication password (minimum 8 characters).",
          "id": "auth_password",
          "inline_format": "plain",
          "label": "Auth Password",
          "optional": false,
          "secret": true
        },
        {
          "default_value": "Aes128",
          "field_type": "select",
          "group": "Privacy",
          "help_text": "Privacy (encryption) algorithm.",
          "id": "priv_protocol",
          "label": "Privacy Protocol",
          "optional": false,
          "options": [
            {
              "label": "AES-128",
              "value": "Aes128"
            },
            {
              "label": "AES-256",
              "value": "Aes256"
            }
          ],
          "secret": false
        },
        {
          "field_type": "secretpathorinline",
          "group": "Privacy",
          "help_text": "Privacy (encryption) password (minimum 8 characters).",
          "id": "priv_password",
          "inline_format": "plain",
          "label": "Privacy Password",
          "optional": false,
          "secret": true
        },
        {
          "field_type": "string",
          "help_text": "Optional SNMPv3 context name. Leave blank for the default context (used by interface and LLDP data).",
          "id": "context_name",
          "label": "Context Name",
          "optional": true,
          "placeholder": "(default)",
          "secret": false
        }
      ],
      "has_logo": false,
      "logo_ext": "",
      "logo_needs_white_background": false,
      "requires_config": true,
      "single_endpoint_per_host": false,
      "targets": [
        "DaemonHost",
        "Hosts",
        "Network"
      ]
    }
  },
  {
    "id": "DockerProxy",
    "name": "Docker Proxy",
    "description": "Discover Docker containers and the services they expose. Connects over TCP, optionally with TLS.",
    "category": "Container & Virtualization",
    "icon": "box",
    "color": "Blue",
    "metadata": {
      "associated_service": "Docker",
      "fields": [
        {
          "default_value": "2375",
          "field_type": "string",
          "group": "Connection",
          "help_text": "Docker API port. Use 2375 for non-TLS proxies (Tecnativa, HAProxy) or 2376 for TLS.",
          "id": "port",
          "label": "Docker API Port",
          "optional": true,
          "placeholder": "2375",
          "secret": false
        },
        {
          "field_type": "string",
          "group": "Connection",
          "help_text": "Optional URL path prefix appended after the port",
          "id": "path",
          "label": "URL Path Prefix",
          "optional": true,
          "placeholder": "/",
          "secret": false
        },
        {
          "field_type": "pathorinline",
          "group": "TLS",
          "help_text": "PEM-encoded client certificate. All three TLS fields (cert, key, CA chain) must be provided together.",
          "id": "ssl_cert",
          "inline_format": "pemcertificate",
          "label": "SSL Certificate",
          "optional": true,
          "placeholder": "-----BEGIN CERTIFICATE-----",
          "secret": false
        },
        {
          "field_type": "secretpathorinline",
          "group": "TLS",
          "help_text": "PEM private key. All three TLS fields must be provided together.",
          "id": "ssl_key",
          "inline_format": "pemprivatekey",
          "label": "SSL Private Key",
          "optional": true,
          "secret": true
        },
        {
          "field_type": "pathorinline",
          "group": "TLS",
          "help_text": "PEM-encoded CA certificate chain. All three TLS fields must be provided together.",
          "id": "ssl_chain",
          "inline_format": "pemcertificate",
          "label": "SSL CA Chain",
          "optional": true,
          "placeholder": "-----BEGIN CERTIFICATE-----",
          "secret": false
        }
      ],
      "has_logo": true,
      "logo_ext": "svg",
      "logo_needs_white_background": false,
      "requires_config": true,
      "single_endpoint_per_host": true,
      "targets": [
        "DaemonHost",
        "Hosts"
      ]
    }
  },
  {
    "id": "DockerSocket",
