FROM debian:bookworm-slim

ARG TARGETARCH

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    iproute2 \
    iputils-ping \
    lldpd \
    net-tools \
    procps \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

# Pre-built binary copied in during build (named by architecture)
COPY scanopy-daemon-linux-${TARGETARCH} /usr/local/bin/scanopy-daemon
RUN chmod +x /usr/local/bin/scanopy-daemon

# The daemon's default config dir (`ProjectDirs` → /root/.config/daemon) is a symlink onto the
# directory the `daemon-config` volume mounts, so config.json lands on the volume. Composes from
# before v0.16.1 mount the volume at /root/.config/daemon itself; Docker resolves that mount
# target through the symlink, so both mounts reach the same directory. The path must match
# `DOCKER_CONFIG_DIR` (backend/src/daemon/shared/config.rs).
RUN mkdir -p /root/.config/scanopy/daemon \
    && ln -s /root/.config/scanopy/daemon /root/.config/daemon

# Notice for third-party data compiled into the binary (Rapid7 Recog, BSD-2-Clause).
COPY assets/recog/LICENSE /usr/share/doc/scanopy/recog/LICENSE

# OCI Image Spec labels — https://github.com/opencontainers/image-spec/blob/main/annotations.md
LABEL org.opencontainers.image.title="Scanopy Daemon" \
      org.opencontainers.image.description="Scanopy daemon — network discovery agent." \
      org.opencontainers.image.url="https://github.com/scanopy/scanopy" \
      org.opencontainers.image.source="https://github.com/scanopy/scanopy" \
      org.opencontainers.image.documentation="https://github.com/scanopy/scanopy#readme" \
      org.opencontainers.image.vendor="Scanopy" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

EXPOSE 60073

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:60073/api/health || exit 1

CMD ["scanopy-daemon"]