[[oidc_providers]]
# Display name shown in UI (e.g., "Authentik", "Keycloak")
name = "Authentik"

# Unique lowercase slug to use in callback URLs
slug = "authentik"

# Optional logo to display next to provider
logo = "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/authentik.svg"

# OIDC provider's issuer URL (try with and without trailing slash if it doesn't work)
issuer_url = "YOUR_ISSUER_URL"

# OAuth2 client ID from provider
client_id = "YOUR_CLIENT_ID"

# OAuth2 client secret from provider
client_secret = "YOUR_CLIENT_SECRET"

# Optional: audiences besides client_id that this provider puts in its ID tokens.
# Leave unset unless login fails with "`<value>` is not a trusted audience".
# Zitadel adds the project ID to every ID token, so list it here:
# trusted_audiences = ["YOUR_ZITADEL_PROJECT_ID"]
