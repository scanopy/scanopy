# shellcheck shell=bash
# SSH lab target list. Sourced by setup.sh (on the VM) and ssh-test-env.sh (on the Mac), so the
# two cannot disagree about which address runs which case.
#
# Parallel arrays: target i is SSH_HOSTS[i], case SSH_CASES[i], accepts SSH_AUTH[i] ("key" or
# "password") and is verified with scripts/SSH_SCRIPTS[i]. Addresses come from the reserved
# 192.168.7.160-169 block. Append only: reordering renumbers every target after the change, and
# Scanopy pins host keys per IP:port, so a renumber shows up as a wall of changed host keys.
#
# shellcheck disable=SC2034  # consumed by the scripts that source this file

SSH_HOSTS=(
    192.168.7.160
    192.168.7.161
    192.168.7.162
    192.168.7.163
    192.168.7.164
    192.168.7.165
    192.168.7.166
    192.168.7.167
    192.168.7.168
)

SSH_CASES=(
    inventory-ok
    password
    exit-nonzero
    bad-json
    timeout
    oversized
    unknown-keys
    hostkey-rotate
    os-unknown-family
)

SSH_AUTH=(
    key
    password
    key
    key
    key
    key
    key
    key
    key
)

SSH_SCRIPTS=(
    inventory-ok.sh
    inventory-ok.sh
    exit-nonzero.sh
    bad-json.sh
    timeout.sh
    oversized.sh
    unknown-keys.sh
    inventory-ok.sh
    os-unknown-family.sh
)

SSH_LAB_USER="scanopy-ssh"
SSH_LAB_CIDR="22"
# Each target's sshd listens here on its own address. Port 22 on the lab addresses is redirected
# to it with nftables, because the VM's main sshd holds 0.0.0.0:22 (see setup.sh, step 4).
SSH_LAB_BACKEND_PORT="2222"
